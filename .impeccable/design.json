    {
      "name": "Step Rail",
      "kind": "nav",
      "refersTo": "rail",
      "description": "The three locked steps, with done steps in gold and the current step on Ultraviolet.",
      "html": "<div class=\"ds-rail\"><span class=\"ds-tab\"><span class=\"ds-node ds-node-done\"><svg class=\"ds-check\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z\"/></svg></span><span class=\"ds-name\">Recipients<small>Done</small></span></span><span class=\"ds-link\"></span><span class=\"ds-tab ds-tab-on\"><span class=\"ds-node ds-node-on\">2</span><span class=\"ds-name\">Message<small>Write your email</small></span></span></div>",
      "css": ".ds-rail{display:inline-flex;align-items:center;gap:.25rem;padding:.375rem;border:1px solid var(--line);border-radius:.875rem;background:var(--surface)}.ds-tab{display:flex;align-items:center;gap:.625rem;padding:.5rem .75rem;border-radius:.5625rem;color:var(--foreground);cursor:pointer;transition:background-color 150ms ease-out}.ds-tab:not(.ds-tab-on):hover{background:var(--surface-2)}.ds-tab-on{background:var(--accent);color:#fff}.ds-name{font-size:.875rem;font-weight:600;line-height:1.25}.ds-name small{display:block;font-size:11px;font-weight:400;opacity:.85}.ds-node{display:flex;align-items:center;justify-content:center;width:1.75rem;height:1.75rem;border:1px solid var(--line-strong);border-radius:50%;font-size:.75rem;font-weight:600}.ds-node-on{border-color:rgb(255 255 255 / .55);background:rgb(255 255 255 / .18);color:#fff}.ds-node-done{border-color:var(--star);background:var(--star);color:var(--on-star)}.ds-check{width:.875rem;height:.875rem}.ds-link{width:1.5rem;height:2px;border-radius:2px;background:var(--star)}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "chip-accent",
      "description": "Readiness checks: accent when confirmed, rose on error.",
      "html": "<span class=\"ds-chips\"><span class=\"ds-chip ds-chip-accent\"><svg class=\"ds-chip-ico\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z\"/></svg>Recipient list ready</span><span class=\"ds-chip ds-chip-danger\"><svg class=\"ds-chip-ico\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z\"/></svg>5 unknown variables</span></span>",
      "css": ".ds-chips{display:inline-flex;flex-wrap:wrap;gap:.5rem}.ds-chip{display:inline-flex;align-items:center;gap:.375rem;padding:.25rem .625rem;border:1px solid var(--line);border-radius:999px;font-size:.75rem;line-height:1rem;font-weight:500}.ds-chip-accent{border-color:color-mix(in srgb,var(--accent-ink) 35%,transparent);background:var(--accent-soft);color:var(--accent-ink)}.ds-chip-danger{border-color:var(--danger-line);background:var(--danger-soft);color:var(--danger)}.ds-chip-ico{width:.875rem;height:.875rem;flex:none}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The opaque surface that holds all work above the sky.",
      "html": "<section class=\"ds-card\"><h3>Subject line</h3><p>One last look before your emails go out.</p></section>",
      "css": ".ds-card{max-width:24rem;padding:1.25rem;border:1px solid var(--line);border-radius:.875rem;background:var(--surface);color:var(--foreground);box-shadow:0 8px 24px -14px rgb(var(--shadow-color) / .55)}.ds-card h3{margin:0;font-size:1.125rem;font-weight:600}.ds-card p{margin:.25rem 0 0;font-size:.875rem;color:var(--muted)}"
    },
    {

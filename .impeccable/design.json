  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The action that moves a step forward, including Send.",
      "html": "<button class=\"ds-btn-primary\">Send 14 emails <svg class=\"ds-ico\" viewBox=\"0 0 20 20\" fill=\"currentColor\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M3.105 2.289a.75.75 0 00-.826.95l1.414 4.925A1.5 1.5 0 005.135 9.25h6.115a.75.75 0 010 1.5H5.135a1.5 1.5 0 00-1.442 1.086l-1.414 4.926a.75.75 0 00.826.95 28.896 28.896 0 0015.293-7.154.75.75 0 000-1.115A28.897 28.897 0 003.105 2.289z\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:.375rem;min-height:2.25rem;padding:.375rem .75rem;border-radius:.5rem;font-size:.875rem;line-height:1.25rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 150ms ease-out,transform 150ms cubic-bezier(.16,1,.3,1);border:1px solid transparent;background:var(--accent);color:#fff;font-weight:600}.ds-btn-primary:hover{background:var(--accent-strong)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px;}.ds-ico{width:.875rem;height:.875rem;flex:none;transition:transform 200ms cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover .ds-ico{transform:translate(2px,-2px)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every non-primary action on a surface.",
      "html": "<button class=\"ds-btn\">Export JSON</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.375rem;min-height:2.25rem;padding:.375rem .75rem;border-radius:.5rem;font-size:.875rem;line-height:1.25rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 150ms ease-out,transform 150ms cubic-bezier(.16,1,.3,1);border:1px solid var(--line-strong);background:var(--surface);color:var(--foreground)}.ds-btn:hover{background:var(--surface-3)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px;}"
